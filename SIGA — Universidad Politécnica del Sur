                      </p>
                      <p class="font-mono tabular-nums" style="font-weight:700;color:var(--navy);margin-top:4px;">${escapeHtml(cert.codigoUnico)}</p>
                    </div>
                  </div>
                </footer>
              </article>
            </div>
          `;
        }

        function renderCertificatesView() {
          const types = [
            { value: "Alumno Regular", label: "Alumno Regular", desc: "Acredita matrícula activa en el semestre vigente." },
            { value: "Notas", label: "Notas", desc: "Incluye asignaturas aprobadas y promedio acumulado." },
            { value: "Matrícula", label: "Matrícula", desc: "Constancia oficial de inscripción financiera y arancel." },
          ];
          const suggestions = ["Asignación familiar", "Postulación a beca", "Trámite bancario", "Pase escolar"];
          const activeCert =
            academicState.certificates.find((c) => c.id === uiState.activeCertId) ||
            academicState.certificates[0] ||
            null;

          return `
            <div class="stack-md">
              <div class="no-print">
                <p class="page-kicker">Emisión Digital · ${escapeHtml(STUDENT_PROFILE.nombre)}</p>
                <h1 class="page-title" style="margin-top:4px;">Solicitar certificado</h1>
                <p class="page-subtitle" style="margin-top:4px;">
                  Elige el tipo de documento, indica el motivo y genera tu certificado al instante con firma electrónica y código QR.
                </p>
              </div>

              <div class="cert-layout">
                <div class="stack-md no-print">
                  <form id="certificate-form" class="card" style="padding:24px;display:flex;flex-direction:column;gap:18px;">
                    <div style="display:flex;flex-direction:column;gap:8px;">
                      <span style="font-size:14px;font-weight:700;">1. Tipo de certificado</span>
                      ${types
                        .map((t) => {
                          const active = uiState.certType === t.value;
                          return `
                            <button type="button" class="cert-type-btn ${active ? "active" : ""}" data-cert-type="${escapeHtml(t.value)}">
                              <p class="font-display" style="font-size:15px;font-weight:700;">${escapeHtml(t.label)}</p>
                              <p style="font-size:12px;margin-top:2px;color:${active ? "rgba(255,255,255,0.85)" : "#4B5563"};">${escapeHtml(t.desc)}</p>
                            </button>`;
                        })
                        .join("")}
                    </div>

                    <div style="display:flex;flex-direction:column;gap:8px;">
                      <label for="cert-motive-input" style="font-size:14px;font-weight:700;">2. Motivo de la solicitud</label>
                      <input
                        id="cert-motive-input"
                        type="text"
                        class="text-input"
                        value="${escapeHtml(uiState.certMotive)}"
                        placeholder="Ej.: Postulación a beca o trámite bancario"
                      />
                      <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        ${suggestions
                          .map(
                            (s) =>
                              `<button type="button" class="filter-chip" style="min-height:34px;padding:6px 10px;font-size:12px;color:var(--navy);" data-motive-suggestion="${escapeHtml(s)}">${escapeHtml(s)}</button>`
                          )
                          .join("")}
                      </div>
                    </div>

                    ${
                      uiState.certError
                        ? `<div role="alert" class="alert alert-error" style="padding:12px 14px;font-size:13px;">
                            <span>${escapeHtml(uiState.certError)}</span>
                          </div>`
                        : ""
                    }

                    <button type="submit" class="btn btn-primary btn-lg btn-full">Generar certificado</button>
                  </form>

                  <section class="card" style="padding:22px;display:flex;flex-direction:column;gap:12px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                      <h2 style="font-size:16px;font-weight:700;">Certificados guardados</h2>
                      <span class="tabular-nums" style="font-size:12px;font-weight:600;color:#6B7280;">${academicState.certificates.length} emitidos</span>
                    </div>
                    ${
                      academicState.certificates.length === 0
                        ? `<p style="font-size:13px;color:#6B7280;line-height:1.5;">Todavía no has generado certificados. Todos los documentos emitidos quedarán guardados aquí automáticamente.</p>`
                        : `<div style="display:flex;flex-direction:column;gap:8px;">
                            ${academicState.certificates
                              .map((c) => {
                                const isActive = activeCert && activeCert.id === c.id;
                                return `
                                  <button type="button" data-select-cert="${escapeHtml(c.id)}" style="width:100%;text-align:left;padding:12px 14px;border-radius:12px;border:1px solid ${
                                    isActive ? "var(--navy)" : "var(--border)"
                                  };background:${isActive ? "#F8FAFF" : "#F8FAFC"};">
                                    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;">
                                      <span style="font-size:14px;font-weight:700;color:#182144;">${escapeHtml(c.tipo)}</span>
                                      <span class="font-mono tabular-nums" style="font-size:12px;font-weight:700;color:var(--navy);">${escapeHtml(c.codigoUnico)}</span>
                                    </div>
                                    <p style="font-size:12px;color:#4B5563;margin-top:4px;">${escapeHtml(c.motivo)} · ${escapeHtml(c.fechaEmisionTexto)}</p>
                                  </button>`;
                              })
                              .join("")}
                          </div>`
                    }
                  </section>
                </div>

                <div>
                  ${
                    activeCert
                      ? `<div class="stack-md">
                          <div class="alert alert-success no-print" style="padding:12px 16px;">
                            <span style="font-size:14px;font-weight:600;">
                              Documento generado y guardado con código <strong class="font-mono">${escapeHtml(activeCert.codigoUnico)}</strong>
                            </span>
                          </div>
                          ${renderCertificateDocument(activeCert)}
                        </div>`
                      : `<div class="card" style="padding:48px 24px;text-align:center;">
                          <div class="icon-box icon-yellow" style="margin:0 auto 14px;" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                          </div>
                          <h2 style="font-size:20px;font-weight:800;">Tu certificado aparecerá aquí</h2>
                          <p style="font-size:14px;color:#4B5563;max-width:420px;margin:8px auto 0;line-height:1.55;">
                            Selecciona el tipo de certificado, escribe el motivo de tu solicitud y presiona “Generar certificado” para verlo al instante con su código QR.
                          </p>
                        </div>`
                  }
                </div>
              </div>
            </div>
          `;
        }

        function renderValidateView() {
          return `
            <div style="max-width:760px;margin:0 auto;" class="stack-md">
              <div>
                <p class="page-kicker">Portal Público de Verificación · Universidad Politécnica del Sur</p>
                <h1 class="page-title" style="margin-top:4px;">Validar certificado</h1>
                <p class="page-subtitle" style="margin-top:4px;">
                  Cualquier persona o institución puede comprobar la autenticidad de un certificado ingresando su código único SIGA.
                </p>
              </div>

              <form id="validate-form" class="card" style="padding:24px;display:flex;flex-direction:column;gap:14px;">
                <label for="validate-code-input" style="font-size:14px;font-weight:700;">Código único del certificado</label>
                <div style="display:flex;flex-wrap:wrap;gap:12px;">
                  <input
                    id="validate-code-input"
                    type="text"
                    class="text-input font-mono"
                    style="flex:1;min-width:220px;min-height:52px;font-size:16px;font-weight:700;text-transform:uppercase;"
                    value="${escapeHtml(uiState.validateCodeInput)}"
                    placeholder="Ej.: SIGA-2026-482910"
                  />
                  <button type="submit" class="btn btn-primary btn-lg">Validar código</button>
                </div>

                ${
                  uiState.validateInputError
                    ? `<div role="alert" class="alert alert-error" style="padding:12px 14px;font-size:13px;">
                        <span>${escapeHtml(uiState.validateInputError)}</span>
                      </div>`
                    : ""
                }
              </form>

              ${
                uiState.validateResult && uiState.validateResult.valid
                  ? `<section role="status" style="background:#ECFDF5;border:2px solid #16A34A;border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:18px;">
                      <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="width:46px;height:46px;border-radius:12px;background:#16A34A;color:#ffffff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div>
                          <h2 style="font-size:24px;font-weight:800;color:#15803D;">Certificado válido</h2>
                          <p style="font-size:14px;color:#166534;margin-top:3px;">
                            El documento consultado se encuentra registrado y vigente en la Universidad Politécnica del Sur.
                          </p>
                        </div>
                      </div>

                      <div class="cert-info-grid" style="background:#ffffff;border-color:rgba(22,163,74,0.3);">
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Nombre del estudiante</p>
                          <p style="font-size:16px;font-weight:800;margin-top:2px;">${escapeHtml(uiState.validateResult.cert.estudianteNombre)}</p>
                        </div>
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Tipo de certificado</p>
                          <p style="font-size:16px;font-weight:800;margin-top:2px;">${escapeHtml(uiState.validateResult.cert.tipo)}</p>
                        </div>
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Fecha de emisión</p>
                          <p class="tabular-nums" style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(uiState.validateResult.cert.fechaEmisionTexto)}</p>
                        </div>
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Código verificado</p>
                          <p class="font-mono tabular-nums" style="font-size:14px;font-weight:700;color:var(--navy);margin-top:2px;">${escapeHtml(uiState.validateResult.cert.codigoUnico)}</p>
                        </div>
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Carrera</p>
                          <p style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(uiState.validateResult.cert.carrera)}</p>
                        </div>
                        <div>
                          <p style="font-size:12px;color:#6B7280;">Motivo declarado</p>
                          <p style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(uiState.validateResult.cert.motivo)}</p>
                        </div>
                      </div>
                    </section>`
                  : ""
              }

              ${
                uiState.validateResult && !uiState.validateResult.valid
                  ? `<section role="alert" style="background:#FEF2F2;border:2px solid #DC2626;border-radius:16px;padding:24px;">
                      <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="width:46px;height:46px;border-radius:12px;background:#DC2626;color:#ffffff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        </div>
                        <div>
                          <h2 style="font-size:24px;font-weight:800;color:#B91C1C;">Certificado no válido</h2>
                          <p style="font-size:14px;color:#7F1D1D;margin-top:5px;line-height:1.55;">
                            No existe ningún certificado registrado con el código <strong class="font-mono">${escapeHtml(uiState.validateResult.code)}</strong>. Verifica que el código tenga formato <span class="font-mono">SIGA-2026-XXXXXX</span>.
                          </p>
                        </div>
                      </div>
                    </section>`
                  : ""
              }

              <section class="card" style="padding:20px;display:flex;flex-direction:column;gap:12px;">
                <p style="font-size:14px;font-weight:700;">Certificados emitidos en este navegador</p>
                ${
                  academicState.certificates.length === 0
                    ? `<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;">
                        <p style="font-size:13px;color:#4B5563;">Aún no has emitido certificados para validar. Puedes solicitar uno en la sección Certificados.</p>
                        <button type="button" class="filter-chip" style="color:var(--navy);" data-nav="certificados">Solicitar certificado</button>
                      </div>`
                    : `<div style="display:flex;flex-wrap:wrap;gap:8px;">
                        ${academicState.certificates
                          .map(
                            (c) =>
                              `<button type="button" class="filter-chip font-mono tabular-nums" style="color:var(--navy);" data-quick-validate="${escapeHtml(c.codigoUnico)}">${escapeHtml(c.codigoUnico)} · ${escapeHtml(c.tipo)}</button>`
                          )
                          .join("")}
                      </div>`
                }
              </section>
            </div>
          `;
        }

        function render() {
          renderNavigation();
          renderFooter();

          const main = document.getElementById("app-main");
          if (uiState.activeTab === "inicio") main.innerHTML = renderHomeView();
          else if (uiState.activeTab === "inscripcion") main.innerHTML = renderEnrollmentView();
          else if (uiState.activeTab === "horario") main.innerHTML = renderScheduleView();
          else if (uiState.activeTab === "certificados") main.innerHTML = renderCertificatesView();
          else if (uiState.activeTab === "validar") main.innerHTML = renderValidateView();

          attachDynamicListeners();
        }

        /* =========================================================
           6. EVENT LISTENERS
           ========================================================= */
        function attachDynamicListeners() {
          const searchInput = document.getElementById("course-search-input");
          if (searchInput) {
            searchInput.addEventListener("input", (e) => {
              const pos = e.target.selectionStart;
              uiState.searchQuery = e.target.value;
              render();
              const refreshed = document.getElementById("course-search-input");
              if (refreshed) {
                refreshed.focus();
                if (typeof pos === "number") refreshed.setSelectionRange(pos, pos);
              }
            });
          }

          const certForm = document.getElementById("certificate-form");
          if (certForm) {
            const motiveInput = document.getElementById("cert-motive-input");
            if (motiveInput) {
              motiveInput.addEventListener("input", (e) => {
                uiState.certMotive = e.target.value;
                if (uiState.certError) {
                  uiState.certError = null;
                }
              });
            }
            certForm.addEventListener("submit", (e) => {
              e.preventDefault();
              const val = (document.getElementById("cert-motive-input")?.value || "").trim();
              if (val.length < 3) {
                uiState.certMotive = val;
                uiState.certError =
                  "Por favor ingresa el motivo de tu solicitud (por ejemplo: Asignación familiar o Postulación a beca).";
                render();
                return;
              }
              generateCertificate(uiState.certType, val);
            });
          }

          const validateForm = document.getElementById("validate-form");
          if (validateForm) {
            const codeInput = document.getElementById("validate-code-input");
            if (codeInput) {
              codeInput.addEventListener("input", (e) => {
                uiState.validateCodeInput = e.target.value.toUpperCase();
              });
            }
            validateForm.addEventListener("submit", (e) => {
              e.preventDefault();
              const val = document.getElementById("validate-code-input")?.value || "";
              validateCertificateCode(val);
            });
          }
        }

        document.addEventListener("click", (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;

          const navBtn = target.closest("[data-nav]");
          if (navBtn) {
            navigateTo(navBtn.getAttribute("data-nav"));
            return;
          }

          if (target.closest("#brand-home-btn") || target.closest("#student-profile-btn")) {
            navigateTo("inicio");
            return;
          }

          if (target.closest("#mobile-menu-toggle")) {
            uiState.mobileMenuOpen = !uiState.mobileMenuOpen;
            renderNavigation();
            return;
          }

          const campusBtn = target.closest("[data-campus]");
          if (campusBtn) {
            uiState.selectedCampus = campusBtn.getAttribute("data-campus");
            render();
            return;
          }

          if (target.closest("#reset-filters-btn")) {
            uiState.selectedCampus = "Todos";
            uiState.searchQuery = "";
            render();
            return;
          }

          if (target.closest("#dismiss-enroll-error")) {
            uiState.enrollError = null;
            render();
            return;
          }

          if (target.closest("#dismiss-enroll-feedback")) {
            uiState.enrollFeedback = null;
            render();
            return;
          }

          const courseBtn = target.closest("[data-toggle-course]");
          if (courseBtn) {
            toggleCourse(courseBtn.getAttribute("data-toggle-course"));
            return;
          }

          if (target.closest("#confirm-enrollment-btn")) {
            confirmEnrollment();
            return;
          }

          if (target.closest("#dismiss-just-confirmed")) {
            uiState.justConfirmed = false;
            render();
            return;
          }

          if (target.closest("#print-page-btn")) {
            window.print();
            return;
          }

          const certTypeBtn = target.closest("[data-cert-type]");
          if (certTypeBtn) {
            uiState.certType = certTypeBtn.getAttribute("data-cert-type");
            render();
            return;
          }

          const motiveSugg = target.closest("[data-motive-suggestion]");
          if (motiveSugg) {
            uiState.certMotive = motiveSugg.getAttribute("data-motive-suggestion");
            uiState.certError = null;
            render();
            return;
          }

          const selectCertBtn = target.closest("[data-select-cert]");
          if (selectCertBtn) {
            uiState.activeCertId = selectCertBtn.getAttribute("data-select-cert");
            uiState.copiedCode = false;
            render();
            return;
          }

          const copyBtn = target.closest("#copy-cert-code-btn");
          if (copyBtn) {
            const code = copyBtn.getAttribute("data-code");
            if (code) {
              const markCopied = () => {
                uiState.copiedCode = true;
                render();
                window.setTimeout(() => {
                  uiState.copiedCode = false;
                  render();
                }, 2000);
              };
              if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(markCopied).catch(() => {});
              } else {
                const ta = document.createElement("textarea");
                ta.value = code;
                ta.style.position = "fixed";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.select();
                try {
                  document.execCommand("copy");
                  markCopied();
                } catch {}
                document.body.removeChild(ta);
              }
            }
            return;
          }

          const valThisBtn = target.closest("#validate-this-cert-btn");
          if (valThisBtn) {
            const code = valThisBtn.getAttribute("data-code");
            uiState.activeTab = "validar";
            validateCertificateCode(code);
            window.scrollTo({ top: 0, behavior: "smooth" });
            return;
          }

          const quickValBtn = target.closest("[data-quick-validate]");
          if (quickValBtn) {
            const code = quickValBtn.getAttribute("data-quick-validate");
            validateCertificateCode(code);
            return;
          }

          if (target.closest("#open-reset-btn")) {
            uiState.confirmResetOpen = true;
            renderFooter();
            return;
          }

          if (target.closest("#cancel-reset-btn")) {
            uiState.confirmResetOpen = false;
            renderFooter();
            return;
          }

          if (target.closest("#confirm-reset-btn")) {
            academicState = createInitialState();
            saveState(academicState);
            uiState.confirmResetOpen = false;
            uiState.justConfirmed = false;
            uiState.enrollError = null;
            uiState.enrollFeedback = null;
            uiState.activeCertId = null;
            uiState.validateCodeInput = "";
            uiState.validateResult = null;
            navigateTo("inicio");
          }
        });

        // Soporte directo para enlaces QR (?validar=SIGA-2026-XXXXXX)
        const params = new URLSearchParams(window.location.search);
        const qrCodeParam = params.get("validar");
        if (qrCodeParam && qrCodeParam.trim()) {
          uiState.activeTab = "validar";
          validateCertificateCode(qrCodeParam);
        } else {
          render();
        }
      })();
    </script>
  </body>
</html>
