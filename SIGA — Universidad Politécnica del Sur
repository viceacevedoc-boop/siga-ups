            carrera: STUDENT_PROFILE.carrera,
            fechaEmisionIso: nowIso,
            fechaEmisionTexto: formatSpanishDate(nowIso),
            selloHash: generateSealHash(),
          };
          updateAcademicState((prev) => ({
            ...prev,
            certificates: [record, ...prev.certificates],
          }));
          uiState.activeCertId = record.id;
          uiState.certMotive = "";
          uiState.certError = null;
          uiState.copiedCode = false;
          render();
