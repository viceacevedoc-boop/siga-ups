          if (academicState.draftSelectedIds.length === 0) {
            uiState.enrollFeedback = null;
            uiState.enrollError =
              "Debes inscribir al menos una asignatura antes de confirmar tu inscripción.";
            render();
            return;
          }

          const nowIso = new Date().toISOString();
          updateAcademicState((prev) => ({
            ...prev,
            confirmedIds: [...prev.draftSelectedIds],
            lastConfirmationAt: nowIso,
          }));
          uiState.enrollError = null;
          uiState.enrollFeedback = null;
          uiState.justConfirmed = true;
          uiState.activeTab = "horario";
          render();
          window.scrollTo({ top: 0, behavior: "smooth" });
