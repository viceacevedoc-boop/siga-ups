        function toggleCourse(courseId) {
          const target = academicState.courses.find((c) => c.id === courseId);
          if (!target) return;

          const alreadySelected = academicState.draftSelectedIds.includes(courseId);

          if (alreadySelected) {
            updateAcademicState((prev) => ({
              ...prev,
              courses: prev.courses.map((c) =>
                c.id === courseId
                  ? { ...c, cuposDisponibles: Math.min(c.cuposTotales, c.cuposDisponibles + 1) }
                  : c
              ),
              draftSelectedIds: prev.draftSelectedIds.filter((id) => id !== courseId),
            }));
            uiState.enrollError = null;
            uiState.enrollFeedback = `Quitaste ${target.nombre} de tu selección y se liberó 1 cupo.`;
            render();
            return;
          }

          if (target.cuposDisponibles <= 0) {
            uiState.enrollFeedback = null;
            uiState.enrollError = `No quedan cupos disponibles en ${target.nombre} (${target.seccion}).`;
            render();
            return;
          }

          const selectedCourses = academicState.courses.filter((c) =>
            academicState.draftSelectedIds.includes(c.id)
          );

          for (const existing of selectedCourses) {
            for (const eb of existing.bloques) {
              const conflict = target.bloques.find(
                (b) => b.dia === eb.dia && b.bloqueId === eb.bloqueId
              );
              if (conflict) {
                const blockObj = TIME_BLOCKS.find((tb) => tb.id === conflict.bloqueId);
                const timeText = blockObj ? blockObj.label : conflict.bloqueId;
                uiState.enrollFeedback = null;
                uiState.enrollError = `Choque de horario: ${target.nombre} coincide con ${existing.nombre} el ${conflict.dia} (${timeText}).`;
                render();
                return;
              }
            }
          }

          updateAcademicState((prev) => ({
            ...prev,
            courses: prev.courses.map((c) =>
              c.id === courseId
                ? { ...c, cuposDisponibles: Math.max(0, c.cuposDisponibles - 1) }
                : c
            ),
            draftSelectedIds: [...prev.draftSelectedIds, courseId],
          }));
          uiState.enrollError = null;
          uiState.enrollFeedback = `Inscribiste ${target.nombre} en tu selección actual.`;
          render();
        }

