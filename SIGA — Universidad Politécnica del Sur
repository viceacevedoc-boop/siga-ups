                  </div>
                </header>

                <div style="display:flex;flex-direction:column;gap:18px;">
                  <h2 style="font-size:24px;font-weight:800;text-align:center;">${escapeHtml(titleMap[cert.tipo])}</h2>
                  <p style="font-size:15px;line-height:1.65;color:#1E293B;">${escapeHtml(bodyMap[cert.tipo])}</p>

                  <div class="cert-info-grid">
                    <div>
                      <p style="font-size:12px;color:#6B7280;">Estudiante</p>
