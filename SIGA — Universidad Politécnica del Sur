          }
          uiState.validateInputError = null;
          const match = academicState.certificates.find(
            (c) => c.codigoUnico.toUpperCase() === normalized
          );
          if (match) {
            uiState.validateResult = { valid: true, cert: match };
          } else {
            uiState.validateResult = { valid: false, code: normalized };
