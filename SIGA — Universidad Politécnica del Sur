                                      <div>
                                        <p class="font-mono" style="font-size:11px;font-weight:700;opacity:0.9;">${escapeHtml(course.codigo)} · ${escapeHtml(course.seccion)}</p>
                                        <p style="font-size:12px;font-weight:700;line-height:1.3;margin-top:3px;">${escapeHtml(course.nombre)}</p>
