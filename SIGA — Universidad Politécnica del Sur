                    <svg width="68" height="68" viewBox="0 0 80 80" fill="none" aria-label="Sello de firma electrónica" style="flex-shrink:0;">
                      <circle cx="40" cy="40" r="36" stroke="#2F3E7E" stroke-width="2.5" stroke-dasharray="4 2"/>
                      <circle cx="40" cy="40" r="28" fill="#F1F4FA" stroke="#2F3E7E" stroke-width="1.5"/>
                      <path d="M28 41L36 49L53 31" stroke="#FD6068" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
