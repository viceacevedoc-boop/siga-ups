        }

        function createInitialState() {
          return {
            courses: cloneInitialCourses(),
            draftSelectedIds: [],
            confirmedIds: [],
            lastConfirmationAt: null,
            certificates: [],
          };
        }

        function loadState() {
          try {
            const raw = window.localStorage.getItem(STORAGE_KEY);
            if (!raw) return createInitialState();
            const parsed = JSON.parse(raw);
            return {
              courses:
                Array.isArray(parsed.courses) && parsed.courses.length === INITIAL_COURSES.length
                  ? parsed.courses
                  : cloneInitialCourses(),
              draftSelectedIds: Array.isArray(parsed.draftSelectedIds) ? parsed.draftSelectedIds : [],
              confirmedIds: Array.isArray(parsed.confirmedIds) ? parsed.confirmedIds : [],
              lastConfirmationAt:
                typeof parsed.lastConfirmationAt === "string" ? parsed.lastConfirmationAt : null,
              certificates: Array.isArray(parsed.certificates) ? parsed.certificates : [],
            };
          } catch {
            return createInitialState();
          }
        }

        function saveState(next) {
          try {
            window.localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
          } catch {
            // Ignorar si el navegador bloquea almacenamiento local
          }
        }

        function escapeHtml(str) {
          return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function formatSpanishDate(iso) {
          try {
            return new Intl.DateTimeFormat("es-CL", {
              day: "numeric",
              month: "long",
              year: "numeric",
            }).format(new Date(iso));
          } catch {
            return iso;
          }
        }

        function formatSpanishDateTime(iso) {
          try {
            return new Intl.DateTimeFormat("es-CL", {
              day: "numeric",
              month: "short",
              year: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            }).format(new Date(iso));
          } catch {
            return iso;
          }
        }

        function generateUniqueCertCode(existing) {
          const set = new Set(existing.map((c) => c.codigoUnico.toUpperCase()));
          for (let i = 0; i < 60; i++) {
            const num = Math.floor(100000 + Math.random() * 900000);
            const candidate = `SIGA-2026-${num}`;
            if (!set.has(candidate)) return candidate;
          }
          return `SIGA-2026-${String(Date.now()).slice(-6)}`;
        }

        function generateSealHash() {
          const chars = "ABCDEF0123456789";
          let out = "";
          for (let i = 0; i < 16; i++) {
            out += chars[Math.floor(Math.random() * chars.length)];
          }
          return out;
        }

