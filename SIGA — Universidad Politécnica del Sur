          const bodyMap = {
            "Alumno Regular": `La Secretaría General de la Universidad Politécnica del Sur certifica que don/doña ${cert.estudianteNombre}, RUT ${cert.estudianteRut}, matrícula ${cert.estudianteMatricula}, se encuentra debidamente inscrito(a) como estudiante regular de la carrera de ${cert.carrera} durante el período académico ${STUDENT_PROFILE.semestre}.`,
            Notas: `La Secretaría General de la Universidad Politécnica del Sur certifica las calificaciones registradas en el historial académico de don/doña ${cert.estudianteNombre}, RUT ${cert.estudianteRut}, matrícula ${cert.estudianteMatricula}, estudiante de la carrera de ${cert.carrera}.`,
            Matrícula: `La Secretaría General de la Universidad Politécnica del Sur certifica que don/doña ${cert.estudianteNombre}, RUT ${cert.estudianteRut}, matrícula ${cert.estudianteMatricula}, mantiene su matrícula financiera y académica vigente para el período ${STUDENT_PROFILE.semestre} en la carrera de ${cert.carrera}.`,
          };

          const originOk =
            window.location.origin &&
            window.location.origin !== "null" &&
            !window.location.origin.startsWith("file:");
          const candidateUrl = originOk
            ? `${window.location.origin}/?validar=${cert.codigoUnico}`
            : `SIGA-VERIFICACION:${cert.codigoUnico}|UPS`;
