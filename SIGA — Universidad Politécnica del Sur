                        return `
                          <section class="card" style="overflow:hidden;">
                            <div class="day-card-header">
                              <h2 style="font-size:16px;font-weight:700;">${escapeHtml(day)}</h2>
                              <span class="tabular-nums" style="font-size:12px;color:#F9E79F;">
                                ${dayItems.length === 0 ? "Sin clases" : `${dayItems.length} bloque(s)`}
                              </span>
                            </div>
                            ${
                              dayItems.length === 0
                                ? `<p style="padding:14px 16px;font-size:14px;color:#6B7280;">No tienes asignaturas programadas para este día.</p>`
                                : `<div style="padding:12px;display:flex;flex-direction:column;gap:10px;">
                                    ${dayItems
                                      .map(
                                        ({ blk, course, sala }) => `
                                      <div class="schedule-block ${styleByCourseId.get(course.id)}" style="height:auto;padding:14px;">
                                        <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;">
