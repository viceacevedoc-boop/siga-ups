                      <button type="button" class="btn btn-primary btn-lg" data-nav="inscripcion">Ir a inscribir ramos</button>
                    </div>`
                  : `
                    <div class="timetable-desktop">
                      <table class="timetable-table">
                        <thead>
                          <tr>
                            <th style="width:140px;">Bloque horario</th>
                            ${DAYS_OF_WEEK.map((d) => `<th>${escapeHtml(d)}</th>`).join("")}
                          </tr>
                        </thead>
                        <tbody>
                          ${TIME_BLOCKS.map(
                            (blk) => `
                            <tr>
                              <td class="time-cell">
                                <p class="tabular-nums" style="font-size:12px;font-weight:800;color:var(--navy);">${escapeHtml(blk.id)}</p>
