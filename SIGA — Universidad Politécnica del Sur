                    <div>
                      <p style="font-size:12px;color:#6B7280;">Carrera</p>
                      <p style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(cert.carrera)}</p>
                    </div>
                    <div>
                      <p style="font-size:12px;color:#6B7280;">Fecha de emisión</p>
                      <p class="tabular-nums" style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(cert.fechaEmisionTexto)}</p>
                    </div>
                    <div style="grid-column:1/-1;">
                      <p style="font-size:12px;color:#6B7280;">Motivo de emisión</p>
                      <p style="font-size:14px;font-weight:600;margin-top:2px;">${escapeHtml(cert.motivo)}</p>
                    </div>
                  </div>

                  ${
                    cert.tipo === "Notas"
                      ? `<div style="border:1px solid #E2E6F0;border-radius:12px;overflow:hidden;">
                          <table class="grades-table">
                            <thead>
                              <tr>
                                <th>Código</th>
