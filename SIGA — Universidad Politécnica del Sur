<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIGA — Universidad Politécnica del Sur</title>
    <meta
      name="description"
      content="Sistema Integrado de Gestión Académica (SIGA) de la Universidad Politécnica del Sur. Inscripción de asignaturas, horario semanal, certificados digitales y validación."
    />
    <meta property="og:title" content="SIGA — Universidad Politécnica del Sur" />
    <meta
      property="og:description"
      content="Portal estudiantil para inscripción de ramos, consulta de horario semanal y certificados académicos con verificación QR."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --navy: #2f3e7e;
        --navy-dark: #222e60;
        --ink: #182144;
        --coral: #fd6068;
        --coral-dark: #c9363f;
        --soft-yellow: #f9e79f;
        --soft-yellow-border: #e5c95c;
        --bg: #f6f7fb;
        --surface: #ffffff;
        --surface-muted: #f8fafc;
        --border: #e2e6f0;
        --border-strong: #cbd5e1;
        --text-muted: #4b5563;
        --text-subtle: #6b7280;
        --green: #16a34a;
        --green-dark: #15803d;
        --green-bg: #ecfdf5;
        --red: #dc2626;
        --red-dark: #b91c1c;
        --red-bg: #fef2f2;
        --font-display: "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-sans: "DM Sans", ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
        background: var(--bg);
        color: var(--ink);
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        margin: 0;
      }

      p {
        margin: 0;
      }

      button,
      input {
        font-family: inherit;
      }

      button {
        cursor: pointer;
      }

      button:focus-visible,
      input:focus-visible {
        outline: 2px solid var(--navy);
        outline-offset: 2px;
      }

      .tabular-nums {
        font-variant-numeric: tabular-nums;
      }

      .font-mono {
        font-family: var(--font-mono);
      }

      .font-display {
        font-family: var(--font-display);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
      }

      /* Top Navigation (3-Zone Contract) */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }

      .header-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 16px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
      }

      .brand-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: transparent;
        border: none;
        padding: 4px 2px;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .brand-mark {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--navy);
        color: var(--soft-yellow);
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .brand-title {
        font-family: var(--font-display);
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--navy);
      }

      .nav-desktop {
        display: none;
        align-items: center;
        gap: 24px;
      }

      .nav-link {
        position: relative;
        background: transparent;
        border: none;
        padding: 10px 2px;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-muted);
        white-space: nowrap;
        flex-shrink: 0;
        transition: color 0.15s ease;
      }

      .nav-link:hover {
        color: var(--navy);
      }

      .nav-link.active {
        color: var(--navy);
        font-weight: 700;
      }

      .nav-link.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 2px;
        height: 2px;
        border-radius: 999px;
        background: var(--coral);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .student-btn {
        display: none;
        align-items: center;
        padding: 8px 14px;
        border-radius: 10px;
        border: none;
        background: #f1f4fa;
        color: var(--navy);
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        transition: background 0.15s ease;
      }

      .student-btn:hover {
        background: #e5eaf5;
      }

      .menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--navy);
      }

      .nav-mobile {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .nav-mobile.hidden {
        display: none;
      }

      .nav-mobile-btn {
        width: 100%;
        text-align: left;
        padding: 12px 16px;
        min-height: 46px;
        border-radius: 10px;
        border: none;
        background: transparent;
        color: var(--ink);
        font-size: 16px;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-mobile-btn.active {
        background: var(--navy);
        color: #ffffff;
        font-weight: 700;
      }

      /* Main Container */
      .main-content {
        flex: 1;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 16px 48px;
      }

      .stack-lg {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .stack-md {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      /* Surfaces & Buttons */
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 15px;
        min-height: 46px;
        padding: 12px 20px;
        border: 1px solid transparent;
        white-space: nowrap;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
      }

      .btn-lg {
        min-height: 52px;
        padding: 14px 24px;
        font-size: 16px;
      }

      .btn-primary {
        background: var(--navy);
        color: #ffffff;
      }

      .btn-primary:hover {
        background: var(--navy-dark);
      }

      .btn-secondary {
        background: var(--surface);
        border-color: #d4dae8;
        color: var(--navy);
      }

      .btn-secondary:hover {
        background: var(--bg);
      }

      .btn-danger-soft {
        background: #fff1f2;
        border-color: var(--coral);
        color: #9f1239;
      }

      .btn-danger-soft:hover {
        background: #ffe4e6;
      }

      .btn-muted {
        background: #e5e7eb;
        color: #4b5563;
      }

      .btn-muted:hover {
        background: #d1d5db;
      }

      .btn-full {
        width: 100%;
      }

      /* Hero Home */
      .hero-card {
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr;
      }

      .hero-copy {
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 24px;
      }

      .student-intro {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .student-avatar {
        width: 56px;
        height: 56px;
        border-radius: 999px;
        background: #f1f4fa;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--navy);
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 18px;
      }

      .hero-title {
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 800;
        letter-spacing: -0.025em;
        color: var(--ink);
        line-height: 1.15;
        text-wrap: balance;
      }

      .hero-desc {
        margin-top: 10px;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-muted);
        max-width: 60ch;
      }

      .hero-cta-row {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .hero-visual {
        position: relative;
        min-height: 220px;
        background: linear-gradient(135deg, #2f3e7e 0%, #1c2754 100%);
        overflow: hidden;
        display: flex;
        align-items: flex-end;
      }

      .hero-visual svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .hero-visual-caption {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: 20px 24px;
        background: linear-gradient(to top, rgba(24, 33, 68, 0.92), rgba(24, 33, 68, 0.25), transparent);
        color: #ffffff;
      }

      /* KPI Strip */
      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
      }

      .kpi-card {
        padding: 18px;
        border-radius: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
      }

      .kpi-card-yellow {
        background: rgba(249, 231, 159, 0.45);
        border-color: var(--soft-yellow-border);
      }

      .kpi-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-subtle);
      }

      .kpi-value {
        margin-top: 6px;
        font-family: var(--font-display);
        font-size: 26px;
        font-weight: 800;
        color: var(--ink);
      }

      /* Quick Access Cards */
      .access-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .access-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 20px;
        transition: border-color 0.15s ease;
      }

      .access-card:hover {
        border-color: rgba(47, 62, 126, 0.45);
      }

      .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .icon-navy {
        background: rgba(47, 62, 126, 0.1);
        color: var(--navy);
      }

      .icon-coral {
        background: rgba(253, 96, 104, 0.15);
        color: var(--coral-dark);
      }

      .icon-yellow {
        background: var(--soft-yellow);
        color: var(--ink);
      }

      /* Page Header */
      .page-header {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .page-kicker {
        font-size: 12px;
        font-weight: 700;
        color: var(--navy);
      }

      .page-title {
        font-size: clamp(24px, 3.2vw, 32px);
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.02em;
      }

      .page-subtitle {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.5;
      }

      /* Alerts */
      .alert {
        border-radius: 14px;
        padding: 16px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
      }

      .alert-error {
        background: #fff1f2;
        border: 1px solid var(--coral);
        color: #881337;
      }

      .alert-success {
        background: var(--green-bg);
        border: 1px solid rgba(22, 163, 74, 0.45);
        color: #14532d;
      }

      .alert-warn {
        background: rgba(249, 231, 159, 0.48);
        border: 1px solid var(--soft-yellow-border);
        color: var(--ink);
      }

      /* Filters & Inputs */
      .filter-panel {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .input-wrap {
        position: relative;
        width: 100%;
      }

      .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-subtle);
        pointer-events: none;
      }

      .text-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 16px;
        border-radius: 12px;
        border: 1px solid #d4dae8;
        background: var(--surface-muted);
        color: var(--ink);
        font-size: 14px;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .text-input.with-icon {
        padding-left: 42px;
      }

      .text-input:focus {
        background: var(--surface);
        border-color: var(--navy);
        outline: none;
      }

      .campus-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .filter-chip {
        min-height: 42px;
        padding: 8px 14px;
        border-radius: 10px;
        border: none;
        background: #f1f4fa;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .filter-chip:hover {
        background: #e5eaf5;
      }

      .filter-chip.active {
        background: var(--navy);
        color: #ffffff;
      }

      /* Enrollment Layout */
      .enroll-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        align-items: start;
      }

      .course-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .course-card {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .course-card.selected {
        border-color: var(--navy);
        background: #f8faff;
      }

      .course-meta-line {
        font-size: 12px;
        color: var(--text-subtle);
      }

      .course-title {
        font-size: 19px;
        font-weight: 700;
        color: var(--ink);
        margin-top: 4px;
      }

      .course-details {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        margin-top: 10px;
        font-size: 14px;
        color: var(--text-muted);
      }

      .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .course-action-col {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
      }

      .summary-panel {
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .summary-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .summary-item {
        padding: 12px 0;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
      }

      .summary-item:first-child {
        padding-top: 0;
      }

      .summary-item:last-child {
        padding-bottom: 0;
        border-bottom: none;
      }

      /* Timetable Grid */
      .timetable-desktop {
        display: none;
        overflow-x: auto;
        border-radius: 16px;
        border: 1px solid var(--border);
        background: var(--surface);
      }

      .timetable-table {
        width: 100%;
        min-width: 780px;
        border-collapse: collapse;
        table-layout: fixed;
      }

      .timetable-table th {
        background: var(--navy);
        color: #ffffff;
        padding: 14px 12px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        border-right: 1px solid rgba(255, 255, 255, 0.15);
      }

      .timetable-table th:last-child {
        border-right: none;
      }

      .timetable-table td {
        border-top: 1px solid var(--border);
        border-right: 1px solid var(--border);
        padding: 8px;
        vertical-align: top;
        height: 112px;
      }

      .timetable-table td:last-child {
        border-right: none;
      }

      .time-cell {
        background: var(--surface-muted);
        padding: 14px 12px !important;
      }

      .schedule-block {
        height: 100%;
        border-radius: 10px;
        border: 1px solid transparent;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 6px;
      }

      .blk-0 { background: #2f3e7e; color: #ffffff; border-color: #222e60; }
      .blk-1 { background: #f9e79f; color: #182144; border-color: #e0c86b; }
      .blk-2 { background: #fff0f1; color: #881337; border-color: rgba(253, 96, 104, 0.5); }
      .blk-3 { background: #ebf0fa; color: #182144; border-color: #b6c5e8; }
      .blk-4 { background: #1e2952; color: #ffffff; border-color: #141b38; }
      .blk-5 { background: #fef3c7; color: #451a03; border-color: rgba(245, 158, 11, 0.45); }

      .timetable-mobile {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .day-card-header {
        background: var(--navy);
        color: #ffffff;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      /* Certificates */
      .cert-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
        align-items: start;
      }

      .cert-type-btn {
        width: 100%;
        text-align: left;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--surface-muted);
        color: var(--ink);
        transition: all 0.15s ease;
      }

      .cert-type-btn.active {
        background: var(--navy);
        border-color: var(--navy);
        color: #ffffff;
      }

      .cert-doc {
        padding: 24px;
        border: 1px solid var(--border-strong);
        border-radius: 16px;
        background: var(--surface);
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .cert-doc-header {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--border);
      }

      .cert-info-grid {
        background: var(--surface-muted);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .cert-footer {
        padding-top: 20px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .qr-box {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px;
        border-radius: 12px;
        background: var(--surface-muted);
        border: 1px solid var(--border);
      }

      .qr-frame {
        width: 104px;
        height: 104px;
        padding: 6px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid var(--border);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Grades Table */
      .grades-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }

      .grades-table th {
        background: var(--navy);
        color: #ffffff;
        padding: 10px 12px;
        text-align: left;
      }

      .grades-table td {
        padding: 10px 12px;
        border-top: 1px solid var(--border);
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
      }

      .footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 18px 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 12px;
        color: var(--text-subtle);
      }

      /* Responsive Breakpoints */
      @media (min-width: 640px) {
        .header-inner { padding: 0 24px; }
        .main-content { padding: 32px 24px 56px; }
        .footer-inner {
          padding: 20px 24px;
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }
        .student-btn { display: inline-flex; }
        .hero-copy { padding: 36px; }
        .hero-cta-row { flex-direction: row; align-items: center; }
        .course-details { grid-template-columns: repeat(2, 1fr); }
        .course-card {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }
        .course-action-col {
          flex-direction: column;
          align-items: flex-end;
          border-top: none;
          padding-top: 0;
          flex-shrink: 0;
        }
        .cert-doc { padding: 36px; }
        .cert-doc-header {
          flex-direction: row;
