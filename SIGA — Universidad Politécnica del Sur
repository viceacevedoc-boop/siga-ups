        /* =========================================================
           2. GENERADOR DE CÓDIGO QR REAL EN JS PURO (ISO/IEC 18004)
           Soporta versiones 1 a 5, modo Byte UTF-8, ECC Nivel L.
           Funciona 100% sin internet ni dependencias externas.
           ========================================================= */
        const QR = (function () {
          const GF_EXP = new Uint8Array(512);
          const GF_LOG = new Uint8Array(256);
          (function initGF() {
            let x = 1;
            for (let i = 0; i < 255; i++) {
              GF_EXP[i] = x;
              GF_LOG[x] = i;
              x <<= 1;
              if (x & 0x100) x ^= 0x11d;
            }
            for (let i = 255; i < 512; i++) {
              GF_EXP[i] = GF_EXP[i - 255];
            }
          })();

          function gfMul(a, b) {
            if (a === 0 || b === 0) return 0;
            return GF_EXP[GF_LOG[a] + GF_LOG[b]];
          }

          function rsGeneratorPoly(degree) {
            let poly = [1];
            for (let i = 0; i < degree; i++) {
              const next = new Array(poly.length + 1).fill(0);
              const root = GF_EXP[i];
              for (let j = 0; j < poly.length; j++) {
                next[j] ^= poly[j];
                next[j + 1] ^= gfMul(poly[j], root);
              }
              poly = next;
            }
            return poly;
          }

          function rsComputeEC(data, ecCount) {
            const gen = rsGeneratorPoly(ecCount);
            const buf = new Uint8Array(data.length + ecCount);
            buf.set(data);
            for (let i = 0; i < data.length; i++) {
              const coef = buf[i];
              if (coef !== 0) {
                for (let j = 0; j < gen.length; j++) {
                  buf[i + j] ^= gfMul(gen[j], coef);
                }
              }
            }
            return buf.slice(data.length);
          }

          // Capacidades ECC Nivel L (1 bloque único en versiones 1-5)
          const SPECS = [
            null,
            { version: 1, size: 21, dataBytes: 19, ecBytes: 7, align: [] },
            { version: 2, size: 25, dataBytes: 34, ecBytes: 10, align: [18] },
            { version: 3, size: 29, dataBytes: 55, ecBytes: 15, align: [22] },
            { version: 4, size: 33, dataBytes: 80, ecBytes: 20, align: [26] },
            { version: 5, size: 37, dataBytes: 108, ecBytes: 26, align: [30] },
          ];

          function utf8Bytes(str) {
            if (typeof TextEncoder !== "undefined") {
              return Array.from(new TextEncoder().encode(str));
            }
            const out = [];
            for (let i = 0; i < str.length; i++) {
              let c = str.charCodeAt(i);
              if (c < 128) out.push(c);
              else if (c < 2048) out.push(192 | (c >> 6), 128 | (c & 63));
              else out.push(224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63));
            }
            return out;
          }

          function encodeMatrix(text) {
            const bytes = utf8Bytes(text);
            let spec = null;
            for (let v = 1; v <= 5; v++) {
              if (bytes.length + 2 <= SPECS[v].dataBytes) {
                spec = SPECS[v];
                break;
              }
            }
            if (!spec) {
              throw new Error("Texto demasiado largo para QR v1-5");
            }

            // Flujo de bits: modo Byte (0100), longitud (8 bits en v1-9), payload, terminador
            const bits = [];
            function pushBits(val, len) {
              for (let i = len - 1; i >= 0; i--) {
                bits.push((val >> i) & 1);
              }
            }
            pushBits(0b0100, 4);
            pushBits(bytes.length, 8);
            for (const b of bytes) pushBits(b, 8);
            const maxBits = spec.dataBytes * 8;
            const termLen = Math.min(4, maxBits - bits.length);
            pushBits(0, termLen);
            while (bits.length % 8 !== 0) bits.push(0);

            const data = [];
            for (let i = 0; i < bits.length; i += 8) {
              let byte = 0;
              for (let j = 0; j < 8; j++) byte = (byte << 1) | bits[i + j];
              data.push(byte);
            }
            const padBytes = [0xec, 0x11];
            let padIdx = 0;
            while (data.length < spec.dataBytes) {
              data.push(padBytes[padIdx % 2]);
              padIdx++;
            }

            const ec = rsComputeEC(data, spec.ecBytes);
            const allCodewords = data.concat(Array.from(ec));

            const n = spec.size;
            const modules = Array.from({ length: n }, () => new Array(n).fill(false));
            const isFunc = Array.from({ length: n }, () => new Array(n).fill(false));

            function setFunc(r, c, dark) {
              if (r >= 0 && r < n && c >= 0 && c < n) {
                modules[r][c] = dark;
                isFunc[r][c] = true;
              }
            }

            function drawFinder(top, left) {
              for (let dr = -1; dr <= 7; dr++) {
                for (let dc = -1; dc <= 7; dc++) {
                  const r = top + dr;
                  const c = left + dc;
                  if (r < 0 || r >= n || c < 0 || c >= n) continue;
                  const inOuter = dr >= 0 && dr <= 6 && dc >= 0 && dc <= 6;
                  const onBorder = dr === 0 || dr === 6 || dc === 0 || dc === 6;
                  const inCore = dr >= 2 && dr <= 4 && dc >= 2 && dc <= 4;
                  setFunc(r, c, inOuter && (onBorder || inCore));
                }
              }
            }

            drawFinder(0, 0);
            drawFinder(0, n - 7);
            drawFinder(n - 7, 0);

            // Patrón de alineación (v2-v5)
            for (const center of spec.align) {
              for (let dr = -2; dr <= 2; dr++) {
                for (let dc = -2; dc <= 2; dc++) {
                  const dark = Math.max(Math.abs(dr), Math.abs(dc)) !== 1;
                  setFunc(center + dr, center + dc, dark);
                }
              }
            }

            // Patrones de sincronización
            for (let i = 8; i < n - 8; i++) {
              setFunc(6, i, i % 2 === 0);
              setFunc(i, 6, i % 2 === 0);
            }

            // Módulo oscuro fijo y reserva de formato
            setFunc(n - 8, 8, true);
            for (let i = 0; i <= 8; i++) {
              if (!isFunc[8][i]) setFunc(8, i, false);
              if (!isFunc[i][8]) setFunc(i, 8, false);
            }
            for (let i = n - 8; i < n; i++) {
              if (!isFunc[8][i]) setFunc(8, i, false);
              if (!isFunc[i][8]) setFunc(i, 8, false);
            }

            // Colocación zig-zag de bits de datos
            const allBits = [];
            for (const cw of allCodewords) {
              for (let b = 7; b >= 0; b--) allBits.push((cw >> b) & 1);
            }

            let bitIdx = 0;
            let upward = true;
            for (let right = n - 1; right >= 1; right -= 2) {
              if (right === 6) right = 5;
              for (let step = 0; step < n; step++) {
                const r = upward ? n - 1 - step : step;
                for (let dx = 0; dx < 2; dx++) {
                  const c = right - dx;
                  if (!isFunc[r][c]) {
                    modules[r][c] = bitIdx < allBits.length ? allBits[bitIdx++] === 1 : false;
                  }
                }
              }
              upward = !upward;
            }

            function applyFormat(grid, maskId) {
              // ECC Level L = 01
              const dataBits = (0b01 << 3) | maskId;
              let rem = dataBits << 10;
              for (let i = 4; i >= 0; i--) {
                if ((rem >> (i + 10)) & 1) {
                  rem ^= 0x537 << i;
                }
              }
              const fmt = ((dataBits << 10) | rem) ^ 0x5412;
              const bit = (k) => ((fmt >> k) & 1) === 1;
              for (let i = 0; i <= 5; i++) grid[8][i] = bit(14 - i);
              grid[8][7] = bit(8);
              grid[8][8] = bit(7);
              grid[7][8] = bit(6);
              for (let i = 0; i <= 5; i++) grid[5 - i][8] = bit(5 - i);

              for (let i = 0; i < 7; i++) grid[n - 1 - i][8] = bit(14 - i);
              for (let i = 0; i < 8; i++) grid[8][n - 8 + i] = bit(7 - i);
            }

            function maskFn(maskId, r, c) {
              switch (maskId) {
                case 0: return (r + c) % 2 === 0;
                case 1: return r % 2 === 0;
                case 2: return c % 3 === 0;
                case 3: return (r + c) % 3 === 0;
                case 4: return (Math.floor(r / 2) + Math.floor(c / 3)) % 2 === 0;
                case 5: return ((r * c) % 2) + ((r * c) % 3) === 0;
                case 6: return (((r * c) % 2) + ((r * c) % 3)) % 2 === 0;
                default: return (((r + c) % 2) + ((r * c) % 3)) % 2 === 0;
              }
            }

            function scoreGrid(grid) {
              let penalty = 0;
              for (let r = 0; r < n; r++) {
                let run = 1;
                for (let c = 1; c < n; c++) {
                  if (grid[r][c] === grid[r][c - 1]) {
                    run++;
                    if (run === 5) penalty += 3;
                    else if (run > 5) penalty += 1;
                  } else run = 1;
                }
              }
              for (let c = 0; c < n; c++) {
                let run = 1;
                for (let r = 1; r < n; r++) {
                  if (grid[r][c] === grid[r - 1][c]) {
                    run++;
                    if (run === 5) penalty += 3;
                    else if (run > 5) penalty += 1;
                  } else run = 1;
                }
              }
              for (let r = 0; r < n - 1; r++) {
                for (let c = 0; c < n - 1; c++) {
                  const v = grid[r][c];
                  if (v === grid[r][c + 1] && v === grid[r + 1][c] && v === grid[r + 1][c + 1]) {
                    penalty += 3;
                  }
                }
              }
              return penalty;
            }

            let bestGrid = null;
            let bestScore = Infinity;
            for (let m = 0; m < 8; m++) {
              const candidate = modules.map((row, r) =>
                row.map((val, c) => (isFunc[r][c] ? val : val ^ maskFn(m, r, c)))
              );
              applyFormat(candidate, m);
              const s = scoreGrid(candidate);
              if (s < bestScore) {
                bestScore = s;
                bestGrid = candidate;
              }
            }
            return bestGrid;
          }

          function renderSvg(text) {
            let matrix;
            try {
              matrix = encodeMatrix(text);
            } catch {
              matrix = encodeMatrix(text.slice(0, 60));
            }
            const n = matrix.length;
            const quiet = 2;
            const total = n + quiet * 2;
            let rects = "";
            for (let r = 0; r < n; r++) {
              for (let c = 0; c < n; c++) {
                if (matrix[r][c]) {
                  rects += `<rect x="${c + quiet}" y="${r + quiet}" width="1" height="1" fill="#182144"/>`;
                }
              }
            }
            return `<svg viewBox="0 0 ${total} ${total}" width="92" height="92" shape-rendering="crispEdges" role="img" aria-label="Código QR de verificación">${'<rect width="100%" height="100%" fill="#ffffff"/>'}${rects}</svg>`;
          }

          return { renderSvg };
        })();

        /* =========================================================
           3. UTILIDADES Y PERSISTENCIA EN LOCALSTORAGE
           ========================================================= */
        function cloneInitialCourses() {
          return INITIAL_COURSES.map((c) => ({
            ...c,
            bloques: c.bloques.map((b) => ({ ...b })),
