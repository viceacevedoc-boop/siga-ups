        function renderScheduleView() {
          const confirmed = academicState.courses.filter((c) =>
            academicState.confirmedIds.includes(c.id)
          );
          const totalCredits = confirmed.reduce((s, c) => s + c.creditos, 0);
          const styleByCourseId = new Map();
          confirmed.forEach((c, idx) => styleByCourseId.set(c.id, `blk-${idx % 6}`));

          function getSessions(day, blockId) {
            const list = [];
            for (const c of confirmed) {
              for (const b of c.bloques) {
                if (b.dia === day && b.bloqueId === blockId) {
                  list.push({ course: c, sala: b.sala });
                }
              }
            }
            return list;
          }

          return `
            <div class="stack-md">
              ${
                uiState.justConfirmed
                  ? `<div role="status" class="alert alert-success" style="align-items:center;">
                      <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="width:44px;height:44px;border-radius:12px;background:#16A34A;color:#ffffff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div>
                          <h2 style="font-size:22px;font-weight:800;color:#14532D;">Quedaste inscrito</h2>
                          <p class="tabular-nums" style="font-size:14px;color:#166534;margin-top:3px;">
                            Tu inscripción para ${escapeHtml(STUDENT_PROFILE.semestre)} quedó confirmada con <strong>${confirmed.length}</strong> asignaturas y <strong>${totalCredits} créditos</strong>.
                          </p>
                        </div>
                      </div>
                      <button type="button" id="dismiss-just-confirmed" class="btn btn-secondary" style="min-height:40px;padding:8px 14px;font-size:13px;">Entendido</button>
                    </div>`
                  : ""
              }

              <div class="page-header no-print">
                <div>
                  <p class="page-kicker">Horario Académico · ${escapeHtml(STUDENT_PROFILE.nombre)}</p>
                  <h1 class="page-title" style="margin-top:4px;">Mi horario semanal</h1>
                  <p class="page-subtitle tabular-nums" style="margin-top:4px;">
                    ${
                      academicState.lastConfirmationAt
                        ? `Última confirmación: ${escapeHtml(formatSpanishDateTime(academicState.lastConfirmationAt))}`
                        : "Visualiza aquí la grilla semanal con tus asignaturas confirmadas."
                    }
                  </p>
                </div>

                ${
                  confirmed.length > 0
                    ? `<div style="display:flex;gap:10px;flex-wrap:wrap;">
