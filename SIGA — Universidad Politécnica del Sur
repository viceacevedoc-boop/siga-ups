            candidateUrl.length <= 104 ? candidateUrl : `SIGA:${cert.codigoUnico}`;
          const qrSvg = QR.renderSvg(qrPayload);

          return `
            <div class="stack-md">
              <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;" class="no-print">
